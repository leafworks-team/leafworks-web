{
  "name": "leafworks-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync:brand",
    "dev": "astro dev",
    "check": "astro check",
    "prebuild": "npm run sync:brand",
    "build": "astro check && astro build",
    "build:fast": "npm run sync:brand && astro build",
    "verify": "npm run build && node scripts/verify.mjs && npx wrangler deploy --dry-run",
    "verify:fast": "node scripts/verify.mjs",
    "preview": "npm run build && wrangler dev --port 7788",
    "preview:static": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "motion": "^13.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2"
  }
}
