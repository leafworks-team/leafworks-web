---
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props {
  locale: Locale;
}

const t = getContent(Astro.props.locale);
---

<section class="hero theme-dark">
  <div class="hero__copy container">
    <p class="eyebrow"><span class="signal-dot"></span>{t.hero.eyebrow}</p>
    <h1 class="display">
      {t.hero.title.map((line) => <span class="hero__line">{line}</span>)}
    </h1>
    <p class="lead hero__lead">{t.hero.lead}</p>
  </div>
  <div class="hero__foot container">
    <span class="hero__scroll"><span class="hero__rule"></span>{t.hero.scroll}</span>
    <span>Seoul · Since 2024</span>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 4.75rem);
    padding-block: clamp(4rem, 12vh, 10rem) 3.5rem;
  }

  .hero__copy {
    display: grid;
    gap: 2rem;
  }

  .hero__line {
    display: block;
  }

  .hero__lead {
    max-width: 38rem;
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    margin-top: 4rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__rule {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }
</style>
