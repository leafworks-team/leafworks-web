---
// This public project ID belongs to the Leafworks website.
const projectId = 'zcum7rlqgu';
const productionOrigin = Astro.site?.origin;
---

{
  import.meta.env.PROD && productionOrigin && (
    <script is:inline define:vars={{ projectId, productionOrigin }}>
      (function () {
        // Built previews also contain this script; only the canonical site collects data.
        if (window.location.origin !== productionOrigin || document.getElementById('clarity-tracking')) return;

        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r);
          t.id = 'clarity-tracking';
          t.async = true;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', projectId);
      })();
    </script>
  )
}
