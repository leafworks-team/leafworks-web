---
import ProductCatalog from './products/ProductCatalog';
import { APPS } from '../data/apps';
import { localizedPath, type Locale } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getContent(locale);
const products = APPS.map((app) => ({
  slug: app.slug,
  name: app.name,
  productType: app.productType,
  icon: app.icon,
  headline: (app.card.headline ?? app.tagline)[locale],
  description: app.card.description[locale],
  compactDescription: (app.card.compactDescription ?? app.card.description)[locale],
  category: app.card.category[locale],
  platforms: app.platforms,
  status: t.appDetail.status[app.status],
  href: localizedPath({ key: 'app', slug: app.slug }, locale),
}));
---

<!-- Keep the existing anchor so saved /#apps links still open this section. -->
<section id="apps" class="products theme-light" aria-labelledby="products-title">
  <div class="container products__inner">
    <div class="products__heading">
      <p class="eyebrow eyebrow--accent">{t.products.eyebrow}</p>
      <h2 id="products-title">{t.products.title}</h2>
      <p class="products__lead products__lead--desktop">{t.products.lead}</p>
      <p class="products__lead products__lead--mobile">{t.products.compactLead}</p>
    </div>
    <ProductCatalog client:visible={{ rootMargin: '300px' }} products={products} labels={t.products.catalog} />
  </div>
</section>

<style>
  .products { background: var(--bg-subtle); padding-block: var(--space-96); }
  .products__inner { display: grid; gap: var(--space-48); }
  .products__heading { display: grid; gap: var(--space-16); }
  .products__heading .eyebrow { font-size: 0.875rem; font-weight: 500; letter-spacing: 0; }
  .products__heading h2 { font-size: 3.5rem; font-weight: 700; line-height: 1.15; letter-spacing: -0.026em; }
  .products__lead { font-size: 1.125rem; line-height: 1.6; color: var(--text-secondary); }
  .products__lead--mobile { display: none; }
  @media (max-width: 47.99rem) {
    .products { padding-block: var(--space-32); }
    .products__inner { gap: var(--space-24); padding-inline: var(--space-24); }
    .products__heading { gap: var(--space-8); }
    .products__heading h2 { font-size: 2rem; line-height: 1.3; letter-spacing: -0.015em; }
    .products__lead { font-size: 1rem; }
    .products__lead--desktop { display: none; }
    .products__lead--mobile { display: block; }
  }
</style>
