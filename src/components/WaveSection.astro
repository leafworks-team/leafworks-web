---
/**
 * The dark → light hand-off: the wave curtain rises as this section scrolls
 * into view, and its front layer is the same white as the About section below,
 * so the page simply becomes light.
 */
---

<div class="wave theme-dark" aria-hidden="true">
  <svg class="wave__svg" viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id="wave-leaf" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8bba4f"></stop>
        <stop offset="100%" stop-color="#3a5f0b"></stop>
      </linearGradient>
    </defs>
    <path class="wave__path" fill="url(#wave-leaf)"></path>
    <path class="wave__path" fill="#ffffff"></path>
  </svg>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { buildCurtain } from '../scripts/curtain';

  gsap.registerPlugin(ScrollTrigger);

  const wave = document.querySelector<HTMLElement>('.wave');
  if (wave) {
    const paths = [...wave.querySelectorAll<SVGPathElement>('.wave__path')];
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const tl = buildCurtain(paths, 'rise');
      const st = ScrollTrigger.create({
        trigger: wave,
        start: 'top bottom',
        end: 'bottom bottom',
        scrub: 0.6,
        animation: tl,
      });
      return () => st.kill();
    });
  }
</script>

<style>
  .wave {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .wave__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Without the scroll animation this would be a screen of empty black. */
  @media (prefers-reduced-motion: reduce) {
    .wave {
      display: none;
    }
  }
</style>
