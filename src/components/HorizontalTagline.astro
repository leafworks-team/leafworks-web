---
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props {
  locale: Locale;
}

const t = getContent(Astro.props.locale);
const label = `${t.tagline.first} ${t.tagline.second}`;
---

<section class="horizontal theme-dark" aria-label={label}>
  <div class="horizontal__track">
    {
      // Two identical copies: the loop moves exactly one copy's width and jumps
      // back, which is invisible because the second copy is where the first was.
      [0, 1].map((copy) => (
        <p class="horizontal__text" aria-hidden="true" data-copy={copy}>
          <span>{t.tagline.first}</span>
          <span class="horizontal__accent">{t.tagline.second}</span>
        </p>
      ))
    }
  </div>
</section>

<script>
  /*
   * Based on the GSAP "horizontal text" demo (codepen GreenSock MYyBrZw), but
   * self-running instead of scroll-driven: the line loops left on its own, and
   * each character arrives scattered at the right edge and settles into the
   * line by the time it reaches 30% of the screen — the demo's start "left 100%"
   * / end "left 30%", random(-200, 200) yPercent, random(-20, 20) rotation and
   * back.out(1.2) ease.
   *
   * The demo derives the scatter from scroll through containerAnimation. Here it
   * comes from each character's on-screen x every frame: the track's x plus the
   * character's offset inside the track, measured once. A frame reads nothing
   * from the DOM and only writes transforms.
   */
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  // Speed in viewport widths per second. The text is sized in vw, so tying the
  // speed to the viewport keeps the same pace on a phone and a wide monitor.
  const SPEED = 0.18;
  const START = 1.0; // fraction of the viewport where a character starts settling
  const END = 0.3; // …and where it has fully settled

  const section = document.querySelector<HTMLElement>('.horizontal');
  const track = section?.querySelector<HTMLElement>('.horizontal__track');
  const copies = section ? [...section.querySelectorAll<HTMLElement>('.horizontal__text')] : [];

  /** Horizontal offset of `el` inside `container`. Both copies and the track are
   *  position: relative, so the offsetParent chain always reaches `container`. */
  function offsetWithin(el: HTMLElement, container: HTMLElement): number {
    let x = 0;
    let node: HTMLElement | null = el;
    while (node && node !== container) {
      x += node.offsetLeft;
      node = node.offsetParent as HTMLElement | null;
    }
    return x;
  }

  if (section && track && copies.length === 2) {
    // SplitText measures glyphs; splitting before Pretendard loads would split
    // the fallback face.
    document.fonts.ready.then(() => {
      const mm = gsap.matchMedia();

      mm.add('(prefers-reduced-motion: no-preference)', () => {
        section.classList.add('is-animated');

        const splits = copies.map((el) => SplitText.create(el, { type: 'chars, words' }));
        const perCopy = splits[0].chars.length;
        const chars = splits.flatMap((s) => s.chars as HTMLElement[]);

        // The same scatter for the same character in both copies, so the seam matches.
        const scatter = Array.from({ length: perCopy }, () => ({
          y: gsap.utils.random(-200, 200),
          r: gsap.utils.random(-20, 20),
        }));
        const ease = gsap.parseEase('back.out(1.2)');
        const setY = chars.map((c) => gsap.quickSetter(c, 'yPercent') as (v: number) => void);
        const setR = chars.map((c) => gsap.quickSetter(c, 'rotation', 'deg') as (v: number) => void);
        const setTrackX = gsap.quickSetter(track, 'x', 'px') as (v: number) => void;

        const state = { x: 0 };
        let lefts: number[] = [];
        let viewport = window.innerWidth;
        let loop: gsap.core.Tween | null = null;

        const render = () => {
          setTrackX(state.x);
          const start = viewport * START;
          const span = viewport * (START - END);
          for (let i = 0; i < chars.length; i++) {
            const p = Math.min(1, Math.max(0, (start - (state.x + lefts[i])) / span));
            const k = 1 - ease(p);
            const s = scatter[i % perCopy];
            setY[i](s.y * k);
            setR[i](s.r * k);
          }
        };

        const measure = () => {
          viewport = window.innerWidth;
          const trackLeft = track.getBoundingClientRect().left - state.x;
          lefts = chars.map((c) => trackLeft + offsetWithin(c, track));
          const copyWidth = copies[1].offsetLeft - copies[0].offsetLeft;

          const progress = loop?.progress() ?? 0;
          loop?.kill();
          loop = gsap.fromTo(
            state,
            { x: 0 },
            { x: -copyWidth, duration: copyWidth / (viewport * SPEED), ease: 'none', repeat: -1, onUpdate: render }
          );
          loop.progress(progress);
          render();
        };

        measure();

        // Don't spend frames on a section nobody can see.
        const io = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) loop?.resume();
          else loop?.pause();
        });
        io.observe(section);

        let resizeTimer = 0;
        const onResize = () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(measure, 150);
        };
        window.addEventListener('resize', onResize);

        return () => {
          io.disconnect();
          window.removeEventListener('resize', onResize);
          window.clearTimeout(resizeTimer);
          loop?.kill();
          gsap.set(track, { clearProps: 'transform' });
          splits.forEach((s) => s.revert());
          section.classList.remove('is-animated');
        };
      });
    });
  }
</script>

<style>
  .horizontal {
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: clamp(4rem, 12vh, 8rem) var(--gutter);
  }

  .horizontal__track {
    position: relative;
    display: flex;
  }

  /* Without motion (or before the script runs) the tagline is two plain lines,
     and the duplicate copy is hidden. */
  .horizontal__text {
    position: relative;
    display: grid;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .horizontal__text[data-copy='1'] {
    display: none;
  }

  .horizontal__accent {
    color: var(--text-accent);
  }

  .horizontal:global(.is-animated) {
    height: 80vh;
    height: 80svh;
    min-height: 28rem;
    padding: 0;
  }

  .horizontal:global(.is-animated) .horizontal__track {
    will-change: transform;
  }

  .horizontal:global(.is-animated) .horizontal__text {
    display: flex;
    width: max-content;
    white-space: nowrap;
    gap: 4vw;
    /* Space between the copies matches the space between the two phrases. */
    padding-right: 4vw;
    font-size: clamp(2rem, 10vw, 12rem);
  }
</style>
