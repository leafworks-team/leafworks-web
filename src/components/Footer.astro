---
import { LOCALES, LOCALE_NAMES, LOCALE_SHORT, localizedPath, type Locale } from '../i18n/config';
import { getContent, GITHUB_URL, SUPPORT_EMAIL } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<footer class="footer theme-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/brand/leafworks-lockup-reversed.svg" alt="Leafworks" height="40" draggable="false" />
        <p>{t.footer.tagline}</p>
      </div>
      <div class="footer__columns">
        <div class="footer__col">
          <h2>{t.footer.contact}</h2>
          <a class="accent" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <div class="footer__col">
          <h2>{t.footer.brand}</h2>
          <a class="accent" href={localizedPath({ key: 'brand' }, locale)}>{t.footer.brandLink}</a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="footer__legal">
        <p>{t.footer.business}</p>
        <p class="faint">{t.footer.rights}</p>
      </div>
      <p class="footer__lang">
        {
          LOCALES.map((l, i) => (
            <>
              {i > 0 && ' / '}
              <a href={localizedPath({ key: 'home' }, l)} hreflang={l} lang={l} title={LOCALE_NAMES[l]}>
                {LOCALE_SHORT[l]}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4.5rem 2.5rem;
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-48);
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border-default);
  }

  .footer__brand {
    display: grid;
    gap: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .footer__brand img {
    height: 2.5rem;
    width: auto;
  }

  .footer__columns {
    display: flex;
    gap: 5rem;
  }

  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .footer__col h2 {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .footer__col a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .accent {
    color: var(--text-accent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-16);
    padding-top: 1.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .footer__legal {
    display: grid;
    gap: 0.25rem;
  }

  .faint {
    color: var(--text-tertiary);
  }

  @media (max-width: 47.99rem) {
    .footer__top {
      flex-direction: column;
    }

    .footer__columns {
      flex-direction: column;
      gap: var(--space-24);
    }
  }
</style>
