---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocumentList from '../components/LegalDocumentList.astro';
import { localizedPath, type Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { LEGAL_APPS } from '../data/legal/documents';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<BaseLayout locale={locale} route={{ key: 'legal' }} title={t.legal.title} noindex>
  <section class="legal theme-light">
    <div class="container legal__inner">
      <h1 class="heading-2">{t.legal.title}</h1>
      <p class="legal__lead">{t.legal.lead}</p>
      {
        LEGAL_APPS.map((app) => (
          <section class="legal__app">
            <h2>
              <a href={localizedPath({ key: 'legalApp', app: app.slug }, locale)}>{app.name[locale]}</a>
            </h2>
            <LegalDocumentList locale={locale} app={app.slug} />
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(3rem, 6vw, 5rem) 6rem;
  }

  .legal__inner {
    max-width: calc(48rem + var(--gutter) * 2);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .legal__lead {
    color: var(--text-secondary);
  }

  .legal__app {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .legal__app h2 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .legal__app h2 a {
    color: inherit;
    text-decoration: none;
  }
</style>
